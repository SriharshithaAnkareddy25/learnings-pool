[Unit]
Description=learnings-pool daemon — syncs PAI learnings between teammates over iroh
Documentation=https://github.com/Sriharshitha05/learnings-pool
# Wait for the network so the node can reach a relay/peers on start.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Always-on process: keeps the iroh node alive, syncs the shared notebook, serves the localhost
# HTTP API (what the MCP server calls), and bridges PAI's KNOWLEDGE/ folder both ways.
# %h expands to the user's home directory.
ExecStart=%h/.local/bin/learnings-daemon \
    --data-dir %h/.local/share/learnings-pool \
    --port 11801 \
    serve --api-port 7777 \
    --knowledge-dir %h/.claude/PAI/MEMORY/KNOWLEDGE
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
